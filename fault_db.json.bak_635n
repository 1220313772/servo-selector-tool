  "E420.0": {
   "title": "主回路电缺相",
   "level": "2",
   "reset": "是",
   "mechanism": "驱动器三相输入缺相异常",
   "rows": [
    [
     "1.三相输入线接线不良.",
     "检查非伺服驱动器侧与伺服驱动器主回路输入端子（RST）间线缆是否良好并紧固连接。",
