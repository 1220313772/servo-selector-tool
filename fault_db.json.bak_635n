  "E500.1": {
   "title": "速度反馈溢出",
   "level": "1",
   "reset": "是",
   "mechanism": "FPGA测速溢出。",
   "rows": [
    [
     "1FPGA内部转速溢出.",
     "检查伺服驱动器动力线缆两端与电机线缆UVW端伺服驱动器UVW端的连接、是否一一对应。",
