   ]
  },
  "E605.0": {
   "title": "使能速度过快",
   "level": "1",
   "reset": "是",
   "mechanism": "SIZE-A和B伺服驱动器，使能时速度超额定速。",
   "rows": [
    [
     "伺服上使能时速度超过电机额定转速",
     "确认电机是否处于被拖状态的时候上了使能。",
