         "MS1-R系列伺服电机选型手册-CN-B05.PDF"),
    ]

    _ssl_ctx = ssl.create_default_context()

    def _download_manual(url, dest, btn, state, rem_btn, prog):
        tmp = dest + ".part"
        try:
            req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
            with urllib.request.urlopen(req, timeout=30, context=_ssl_ctx) as r:
                total = r.headers.get("Content-Length")
                total = int(total) if total and str(total).isdigit() else None
                downloaded = 0
                last_update = 0
                prog.visible = True
                prog.value = 0
                page.update()
                with open(tmp, "wb") as f:
                    while True:
                        chunk = r.read(64 * 1024)
                        if not chunk:
                            break
                        f.write(chunk)
                        downloaded += len(chunk)
                        if total:
                            ratio = min(downloaded / total, 1.0)
                            prog.value = ratio
                            btn.text = f"⬇ {int(ratio * 100)}%"
                        else:
                            prog.value = None
                        if downloaded - last_update >= 256 * 1024 or downloaded == total:
                            page.update()
                            last_update = downloaded
            os.replace(tmp, dest)
            state["ready"] = True
            btn.text = "📂 打开"
            btn.bgcolor = "#1E7A3C"
            btn.disabled = False
            rem_btn.visible = True
            prog.visible = False
            _log(f"手册下载完成：{os.path.basename(dest)}")
        except Exception as ex:
            try:
                if os.path.exists(tmp):
                    os.remove(tmp)
            except Exception:
                pass
            state["ready"] = False
            btn.text = "⬇ 重试"
            btn.disabled = False
            prog.visible = False
            _log(f"手册下载失败：{os.path.basename(dest)}（{ex}）", "ERROR")
            tip_text.value = f"手册下载失败：{os.path.basename(dest)}（{ex}）"
            tip_text.color = "red"
        page.update()

    def open_manual_list(e):
        manual_dir = os.path.join(base_dir, "选型手册")
        os.makedirs(manual_dir, exist_ok=True)
        rows = []

        for title, url, filename in MANUALS:
            dest = os.path.join(manual_dir, filename)
            state = {"ready": os.path.exists(dest)}
            btn = ft.ElevatedButton(
                "📂 打开" if state["ready"] else "⬇ 下载",
                height=30,
                bgcolor="#1E7A3C" if state["ready"] else "#2E6DA4",
                color="white",
            )
            rem_btn = ft.ElevatedButton(
                "🗑 移除",
                height=30,
                bgcolor="#B23A3A",
                color="white",
                visible=state["ready"],
            )
            prog = ft.ProgressBar(
                value=0, visible=False, bar_height=6,
                color="#2E6DA4", bgcolor="#DCE6F1", width=420,
            )

            def _on_click(ev, dest=dest, url=url, filename=filename, btn=btn, state=state, rem_btn=rem_btn, prog=prog):
                if state["ready"]:
                    manual_dlg.open = False
                    page.update()
                    before = _snapshot_windows()
                    try:
                        os.startfile(dest)
                        _activate_window(os.path.splitext(filename)[0], before, delay=0.7)
                    except Exception as ex:
                        tip_text.value = f"打开手册失败：{ex}"
                        tip_text.color = "red"
                        page.update()
                    return
                btn.disabled = True
                btn.text = "下载中…"
                page.update()
                threading.Thread(
                    target=_download_manual,
                    args=(url, dest, btn, state, rem_btn, prog),
                    daemon=True,
                ).start()

            def _on_remove(ev, dest=dest, filename=filename, btn=btn, state=state, rem_btn=rem_btn):
                try:
                    if os.path.exists(dest):
                        os.remove(dest)
                    part = dest + ".part"
                    if os.path.exists(part):
                        os.remove(part)
                    state["ready"] = False
                    btn.text = "⬇ 下载"
                    btn.bgcolor = "#2E6DA4"
                    btn.disabled = False
                    rem_btn.visible = False
                    tip_text.value = f"已移除本地手册：{filename}"
                    tip_text.color = "#1E7A3C"
                    _log(f"移除本地手册：{filename}")
                except Exception as ex:
                    _log(f"手册移除失败：{filename}（{ex}）", "ERROR")
                    tip_text.value = f"移除失败：{filename}（{ex}）"
                    tip_text.color = "red"
                page.update()

            btn.on_click = _on_click
            rem_btn.on_click = _on_remove
            meta = ""
            if state["ready"]:
                meta = f"{_fmt_size(dest)} · {_fmt_mtime(dest)}"
            rows.append(ft.Column([
                ft.Row([
                    ft.Text(title, size=12.5, color="#1F2733", expand=True),
                    btn,
                    rem_btn,
                ], spacing=10),
                ft.Text(meta, size=10.5, color="#7B8794") if meta else ft.Container(),
                prog,
            ], spacing=4))

        content = ft.Column(rows, spacing=8, scroll=ft.ScrollMode.AUTO, width=440, height=400)

        def _close_manual(ev):
            manual_dlg.open = False
            page.update()

        manual_dlg = ft.AlertDialog(
            open=True,
            title=ft.Text("选型手册（点下载自动保存到本地）", size=16, weight=ft.FontWeight.BOLD, color="#123A5A"),
            content=content,
            actions=[ft.TextButton("关闭", on_click=_close_manual)],
            actions_alignment=ft.MainAxisAlignment.END,
        )
        page.dialog = manual_dlg
        manual_dlg.open = True
        page.update()

    # ---------- 线缆型号查询弹窗 ----------
    cable_motor = ft.TextField(
        label="电机型号（忽略大小写）",
        hint_text="如 MS1H3-13C15CB-A634R",
        width=320,
    )
    cable_depth = ft.Dropdown(
        label="线缆长度",
        options=[ft.dropdown.Option(v, t) for v, t in [
            ("3.0", "3 m（-3.0）"),
            ("5.0", "5 m（-5.0）"),
            ("10.0", "10 m（-10.0）"),
        ]],
        value="3.0",
        width=150,
    )
    cable_flex = ft.Checkbox(label="高柔线（-T）", value=True)
    cable_result = ft.Column(spacing=8, scroll=ft.ScrollMode.AUTO, height=260, width=460)

    def _cable_card(d, depth, flex):
        motor = str(d.get("motor_model") or "")
        drive = str(d.get("drive_model") or "")
        power = build_line(d.get("power_line_base"), depth, flex)
        enc = build_line(d.get("encoder_line_base"), depth, flex)
        brake_txt = "带抱闸" if str(d.get("has_brake")) == "是" else "无抱闸"
        flex_txt = "高柔" if flex else "普通"
        return ft.Container(
            ft.Column([
                ft.Row([
                    ft.Text(motor, size=12.5, weight=ft.FontWeight.BOLD, color="#1F2733"),
                    ft.Text(drive, size=11, color="#7B8794"),
                ], spacing=8),
                ft.Row([
                    ft.Text("动力线：", size=12, color="#1F2733"),
                    ft.Text(power, size=12.5, weight=ft.FontWeight.BOLD, color="#1E7A3C"),
                ], spacing=6),
                ft.Row([
                    ft.Text("编码线：", size=12, color="#1F2733"),
                    ft.Text(enc, size=12.5, weight=ft.FontWeight.BOLD, color="#1E7A3C"),
                ], spacing=6),
                ft.Text(f"{brake_txt} · {depth}米 · {flex_txt}", size=11, color="#7B8794"),
            ], spacing=4),
            bgcolor="#F4F8F2",
            border_radius=10,
            padding=12,
            border=ft.border.all(1, "#DCEBD6"),
        )

    def on_cable_search(e):
        q = (cable_motor.value or "").strip().upper().replace(" ", "")
        cable_result.controls.clear()
        if not q:
            cable_result.controls.append(ft.Text("请先输入电机型号", size=12.5, color="red"))
            page.update()
            return
        depth = cable_depth.value
        flex = bool(cable_flex.value)
        hits, seen = [], set()
        for d in data:
            m = str(d.get("motor_model") or "").strip().upper()
            if not (q == m or q in m):
                continue
            key = (m, str(d.get("drive_model") or ""))
            if key in seen:
                continue
            seen.add(key)
            hits.append((q == m, d))
        hits.sort(key=lambda x: (not x[0], str(x[1].get("drive_model") or "")))
        if not hits:
            cable_result.controls.append(ft.Text(
                "未在数据库找到该型号，请核对铭牌后重试；型号如有出入可发邮件反馈勘误。",
                size=12.5, color="red"))
        else:
            for _exact, d in hits:
                cable_result.controls.append(_cable_card(d, depth, flex))
        page.update()

    def open_cable_query(e):
        page.dialog = cable_dlg
        cable_dlg.open = True
        page.update()

    def _close_cable(ev):
        cable_dlg.open = False
        page.update()

    cable_dlg = ft.AlertDialog(
        open=False,
        title=ft.Text("线缆型号查询", size=16, weight=ft.FontWeight.BOLD, color="#123A5A"),
        content=ft.Column([
            ft.Row([cable_motor], wrap=True),
            ft.Row([cable_depth, cable_flex], spacing=16, wrap=True),
            ft.Row([
                ft.ElevatedButton("🔍 查询线缆", bgcolor="#2E6DA4", color="white",
                                  height=32, on_click=on_cable_search),
            ], alignment=ft.MainAxisAlignment.END),
            ft.Divider(height=8, color="#EDF1F6"),
            cable_result,
        ], spacing=10, tight=True, width=480),
        actions=[ft.TextButton("关闭", on_click=_close_cable)],
        actions_alignment=ft.MainAxisAlignment.END,
    )

    btn_cable = ft.ElevatedButton(
        "🔌 线缆查询",
        height=34,
        bgcolor="#1E7A3C",
        color="white",
        on_click=open_cable_query,
    )

    # ---------- 纠错 + 版本恢复 ----------
    fix_target = {"it": None, "note": None}
    fix_fields_ctrl = {}

    def _open_fix(e, it):
        fix_target["it"] = it
        fix_fields_ctrl.clear()
        field_rows = []
        for label, col in FIX_FIELDS:
            val = "" if it.get(col) is None else str(it.get(col))
            tf = ft.TextField(label=label, value=val, height=38,
                              content_padding=8, width=440)
            fix_fields_ctrl[col] = tf
            field_rows.append(tf)
        fix_note = ft.TextField(label="纠错备注（可选）", value="", height=38,
                                content_padding=8, width=440)
        fix_target["note"] = fix_note
        fix_dlg.content = ft.Column(
            [ft.Text(f"电机：{it.get('motor_model')}　驱动器：{it.get('drive_model')}",
                     size=12.5, weight=ft.FontWeight.BOLD, color="#123A5A"),
             *field_rows, fix_note],
            spacing=10, scroll=ft.ScrollMode.AUTO, width=460, height=460)
        page.dialog = fix_dlg
        fix_dlg.open = True
        page.update()

    def _close_fix(ev):
        fix_dlg.open = False
        page.update()

    def _save_fix(ev):
        it = fix_target["it"]
        if not it:
            return
        motor = str(it.get("motor_model") or "").strip()
        drive = str(it.get("drive_model") or "").strip()
        changes = []
        for label, col in FIX_FIELDS:
            old = "" if it.get(col) is None else str(it.get(col)).strip()
            new = (fix_fields_ctrl[col].value or "").strip()
            if new != old:
                changes.append((col, label, old, new))
        note = (fix_target["note"].value or "").strip()
        if not changes:
            tip_text.value = "没有需要保存的改动"
            tip_text.color = "#B26A00"
            page.update()
            return
        try:
            os.makedirs(SNAP_DIR, exist_ok=True)
            idx = _next_snapshot_index()
            snap_path = os.path.join(SNAP_DIR, f"纠错_{idx:03d}.xlsx")
            shutil.copy2(DATA_FILE, snap_path)

            wb = openpyxl.load_workbook(DATA_FILE)
            ws = wb["data"]
            header = [c.value for c in ws[1]]
            mi = header.index("motor_model")
            di = header.index("drive_model")
            row_idx = None
            for r in range(2, ws.max_row + 1):
                if str(ws.cell(r, mi + 1).value or "").strip() == motor and \
                   str(ws.cell(r, di + 1).value or "").strip() == drive:
                    row_idx = r
                    break
            if row_idx is None:
                tip_text.value = "未在表格中定位到该记录，未保存"
                tip_text.color = "red"
                page.update()
                return
            for col, label, old, new in changes:
                ci = header.index(col) + 1
                ws.cell(row_idx, ci).value = new if new else None
            wb.save(DATA_FILE)

            entries = _read_fix_log()
            seq = len(entries) + 1
            now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            for col, label, old, new in changes:
                entries.append({
                    "序号": seq, "时间": now, "电机型号": motor, "驱动器": drive,
                    "字段": label, "改前值": old, "改后值": new,
                    "备注": note, "快照文件": os.path.basename(snap_path),
                })
            _write_fix_log(entries)

            for d in data:
                if str(d.get("motor_model") or "").strip() == motor and \
                   str(d.get("drive_model") or "").strip() == drive:
                    for col, label, old, new in changes:
                        d[col] = new if new else None
                    break

            fix_dlg.open = False
            tip_text.value = f"已保存纠错：{motor}（{len(changes)} 项）"
            tip_text.color = "green"
            _log(f"纠错保存：{motor} {drive}，{len(changes)} 项改动")
            refresh(None)
        except Exception as ex:
            _log(f"纠错保存失败：{ex}", "ERROR")
            tip_text.value = f"纠错保存失败：{ex}"
            tip_text.color = "red"
            page.update()

    fix_dlg = ft.AlertDialog(
        open=False,
        title=ft.Text("✏️ 纠错搭配", size=16, weight=ft.FontWeight.BOLD, color="#123A5A"),
        content=ft.Column([ft.Text("")], width=460, height=460),
        actions=[
            ft.TextButton("取消", on_click=_close_fix),
            ft.TextButton("保存纠错", on_click=_save_fix),
        ],
        actions_alignment=ft.MainAxisAlignment.END,
    )

    def _reload_data():
        data[:] = load_excel(DATA_FILE)

    def _restore_snapshot(snap_file):
        if not snap_file:
            return
        snap_path = os.path.join(SNAP_DIR, snap_file)
        if not os.path.exists(snap_path):
            tip_text.value = "快照文件不存在，无法恢复"
            tip_text.color = "red"
            page.update()
            return
        shutil.copy2(snap_path, DATA_FILE)
        _reload_data()
        hist_dlg.open = False
        tip_text.value = f"已恢复到快照：{snap_file}"
        tip_text.color = "green"
        _log(f"恢复快照：{snap_file}")
        refresh(None)

    orig_confirm = {"armed": False}
    orig_btn = ft.ElevatedButton(
        "♻ 恢复出厂原始", height=34, bgcolor="#B23A3A", color="white")

    def _restore_original(ev):
        if not os.path.exists(ORIGINAL_FILE):
            tip_text.value = "未找到出厂原始基线"
            tip_text.color = "red"
            page.update()
            return
        if not orig_confirm["armed"]:
            orig_confirm["armed"] = True
            orig_btn.text = "再次点击确认（撤销全部纠错）"
            orig_btn.color = "red"
            page.update()
            return
        shutil.copy2(ORIGINAL_FILE, DATA_FILE)
        _reload_data()
        orig_confirm["armed"] = False
        orig_btn.text = "♻ 恢复出厂原始"
        orig_btn.color = "white"
        hist_dlg.open = False
        tip_text.value = "已恢复为出厂原始表格（全部纠错已撤销）"
        tip_text.color = "green"
        _log("恢复出厂原始表格（撤销全部纠错）")
        refresh(None)

    orig_btn.on_click = _restore_original

    def _delete_entry(seq, snap_file):
        entries = _read_fix_log()
        kept = [e for e in entries if str(e.get("序号")) != str(seq)]
        if snap_file and not any(str(e.get("快照文件") or "") == snap_file for e in kept):
            sp = os.path.join(SNAP_DIR, snap_file)
            if os.path.exists(sp):
                os.remove(sp)
        _write_fix_log(kept)
        tip_text.value = f"已删除第 {seq} 条纠错记录"
        tip_text.color = "green"
        _log(f"删除纠错记录 #{seq}")
        open_history(None)

    clear_confirm = {"armed": False}
    clear_btn = ft.ElevatedButton("🗑 清空全部记录", height=34, bgcolor="#B23A3A", color="white")

    def _clear_all_entries(ev):
        if not clear_confirm["armed"]:
            clear_confirm["armed"] = True
            clear_btn.text = "再次点击确认清空（不回滚当前表格）"
            clear_btn.color = "red"
            page.update()
            return
        _write_fix_log([])
        if os.path.isdir(SNAP_DIR):
            for f in os.listdir(SNAP_DIR):
                if f.endswith(".xlsx"):
                    os.remove(os.path.join(SNAP_DIR, f))
        clear_confirm["armed"] = False
        clear_btn.text = "🗑 清空全部记录"
        clear_btn.color = "white"
        tip_text.value = "已清空全部纠错记录（当前表格与出厂基线不受影响）"
        _log("清空全部纠错记录")
        tip_text.color = "green"
        open_history(None)

    clear_btn.on_click = _clear_all_entries

    def open_history(e):
        entries = _read_fix_log()
        orig_confirm["armed"] = False
        orig_btn.text = "♻ 恢复出厂原始"
        orig_btn.color = "white"
        clear_confirm["armed"] = False
        clear_btn.text = "🗑 清空全部记录"
        clear_btn.color = "white"
        hist_rows = []
        if not entries:
            hist_rows.append(ft.Text("暂无纠错记录", size=12.5, color="#7B8794"))
        for en in entries:
            snap = en.get("快照文件") or ""
            seq = en.get("序号")
            hist_rows.append(ft.Row([
                ft.Column([
                    ft.Text(f"#{seq}　{en.get('时间')}", size=11, color="#7B8794"),
                    ft.Text(f"{en.get('电机型号')}　{en.get('驱动器')}", size=12, color="#1F2733"),
                    ft.Text(f"{en.get('字段')}：{en.get('改前值') or '空'} → {en.get('改后值') or '空'}",
                            size=11.5, color="#3B76B5"),
                ], spacing=2, expand=True),
                ft.ElevatedButton("恢复此版本", height=30, bgcolor="#5A6B7B", color="white",
                                  on_click=lambda ev, s=snap: _restore_snapshot(s)),
                ft.ElevatedButton("🗑", height=30, bgcolor="#B23A3A", color="white",
                                  on_click=lambda ev, q=seq, fn=snap: _delete_entry(q, fn)),
            ], spacing=10))
        last = entries[-1] if entries else None
        undo_btn = ft.ElevatedButton(
            "↩ 撤销最近一次", height=34, bgcolor="#2E6DA4", color="white",
            disabled=last is None,
            on_click=lambda ev: _restore_snapshot(last.get("快照文件") if last else ""))
        hist_dlg.content = ft.Column(
            [ft.Row([undo_btn, orig_btn, clear_btn], spacing=12),
             ft.Divider(height=8, color="#EDF1F6"),
             *hist_rows],
            spacing=10, scroll=ft.ScrollMode.AUTO, width=480, height=440)
        page.dialog = hist_dlg
        hist_dlg.open = True
        page.update()

    def _close_hist(ev):
        hist_dlg.open = False
        page.update()

    hist_dlg = ft.AlertDialog(
        open=False,
        title=ft.Text("🕘 纠错记录与版本恢复", size=16, weight=ft.FontWeight.BOLD, color="#123A5A"),
        content=ft.Column([ft.Text("")], width=480, height=440),
        actions=[ft.TextButton("关闭", on_click=_close_hist)],
        actions_alignment=ft.MainAxisAlignment.END,
    )

    btn_hist = ft.ElevatedButton(
        "🕘 纠错记录",
        height=34,
        bgcolor="#5A6B7B",
        color="white",
        on_click=open_history,
    )

    # ---------- 更新日志弹窗 ----------
    def open_changelog(e):
        page.dialog = log_dlg
        log_dlg.open = True
        page.update()

    def _close_log(ev):
        log_dlg.open = False
        page.update()

    def _ver_num(title):
        m = re.search(r"(\d+(?:\.\d+){1,2})", title)
        return m.group(1) if m else title

    def _group_key(ver):
        return ".".join(ver.split(".")[:2])

    log_groups = []
    _group_map = {}
    for title, items in CHANGELOG:
        ver = _ver_num(title)
        gk = _group_key(ver)
        if gk not in _group_map:
            _group_map[gk] = []
            log_groups.append((gk, _group_map[gk]))
        _group_map[gk].append((title, ver, items))

    def _version_block(title, ver, items):
        label = f"{title}（{LATEST_DATE}）" if ver == VERSION else title
        return ft.Column([
            ft.Text(label, size=12.5, weight=ft.FontWeight.BOLD, color="#123A5A"),
            ft.Column([ft.Text("• " + it, size=12, color="#1F2733") for it in items], spacing=3),
        ], spacing=5)

    log_tiles = []
    for idx, (gk, entries) in enumerate(log_groups):
        summary = CHANGELOG_SUMMARY.get(gk, "")
        log_tiles.append(ft.ExpansionTile(
            title=ft.Text(f"v{gk}", size=14, weight=ft.FontWeight.BOLD, color="#123A5A"),
            subtitle=ft.Text(summary, size=11.5, color="#5A6675") if summary else None,
            initially_expanded=(idx == 0),
            controls_padding=ft.padding.symmetric(horizontal=14, vertical=6),
            controls=[_version_block(t, v, it) for t, v, it in entries],
        ))

    log_dlg = ft.AlertDialog(
        open=False,
        title=ft.Text(f"更新日志　v{VERSION}", size=16, weight=ft.FontWeight.BOLD, color="#123A5A"),
        content=ft.Column(log_tiles, spacing=8, scroll=ft.ScrollMode.AUTO, width=520, height=440),
        actions=[ft.TextButton("关闭", on_click=_close_log)],
        actions_alignment=ft.MainAxisAlignment.END,
    )

    btn_log = ft.ElevatedButton(
        "📝 更新日志",
        height=34,
        bgcolor="#5A6B7B",
        color="white",
        on_click=open_changelog,
    )

    btn_manual = ft.ElevatedButton(
        "📖 选型手册",
        height=34,
        bgcolor="#123A5A",
        color="white",
        on_click=open_manual_list,
    )

    # ---------- 设置弹窗：默认值 / BOM 模板 / 导出列 / 数据版本 ----------
    s_volt = ft.Dropdown(label="默认供电电压", options=opt("AC220", "AC380"),
                         value=cfg.get("default_voltage", "AC220"), width=205)
    s_depth = ft.Dropdown(
        label="默认线缆长度", width=205,
        options=[ft.dropdown.Option(v, t) for v, t in [
            ("3.0", "3 m（-3.0）"), ("5.0", "5 m（-5.0）"), ("10.0", "10 m（-10.0）")]],
        value=cfg.get("default_depth", "3.0"))
    s_flex = ft.Checkbox(label="默认高柔线（-T）", value=bool(cfg.get("default_high_flex", True)))
    s_format = ft.Dropdown(
        label="BOM 导出格式", width=205,
        options=[ft.dropdown.Option("xlsx", "Excel（.xlsx）"), ft.dropdown.Option("csv", "CSV（.csv）")],
        value=cfg.get("bom_format", "xlsx"))
    s_title = ft.TextField(label="清单标题", value=cfg.get("bom_title", ""), width=205)
    s_company = ft.TextField(label="公司抬头（可留空）", value=cfg.get("bom_company", ""), width=205)
    s_footer = ft.TextField(label="落款（可留空）", value=cfg.get("bom_footer", ""), width=205)
    s_col_type = ft.Checkbox(label="类型", value=bool(cfg.get("col_type", True)))
    s_col_model = ft.Checkbox(label="型号", value=bool(cfg.get("col_model", True)))
    s_col_qty = ft.Checkbox(label="数量", value=bool(cfg.get("col_qty", True)))
    s_col_note = ft.Checkbox(label="备注", value=bool(cfg.get("col_note", True)))
    s_data_ver = ft.TextField(label="数据版本（手册版本号，可留空）", value=cfg.get("data_version", ""), width=205)
    s_data_date = ft.TextField(label="数据日期（YYYY-MM-DD，可留空）", value=cfg.get("data_date", ""), width=205)

    def _save_settings_dlg(ev):
        cfg["default_voltage"] = s_volt.value
        cfg["default_depth"] = s_depth.value
        cfg["default_high_flex"] = s_flex.value
        cfg["watermark"] = "姓许的苏剑"
        cfg["bom_format"] = s_format.value
        cfg["bom_title"] = s_title.value.strip() or "伺服电机与驱动器配置清单"
        cfg["bom_company"] = s_company.value.strip()
        cfg["bom_footer"] = s_footer.value.strip()
        cfg["col_type"] = s_col_type.value
        cfg["col_model"] = s_col_model.value
        cfg["col_qty"] = s_col_qty.value
        cfg["col_note"] = s_col_note.value
        cfg["data_version"] = s_data_ver.value.strip()
        cfg["data_date"] = s_data_date.value.strip()
        try:
            _save_settings(cfg)
            _log("设置已保存")
        except Exception as ex:
            _log(f"设置保存失败：{ex}", "ERROR")
        volt_drop.value = cfg["default_voltage"]
        depth_drop.value = cfg["default_depth"]
        flex_check.value = cfg["default_high_flex"]
        footer_text.value = _footer_text()
        settings_dlg.open = False
        refresh(None)
        page.update()

    settings_dlg = ft.AlertDialog(
        open=False,
        title=ft.Text("⚙️ 设置", size=16, weight=ft.FontWeight.BOLD, color="#123A5A"),
        content=ft.Column([
            ft.Row([s_volt, s_depth], spacing=12),
            s_flex,
            ft.Row([s_format], spacing=12),
            ft.Row([s_title, s_company], spacing=12),
            s_footer,
            ft.Text("导出列：", size=12, color="#7B8794"),
            ft.Row([s_col_type, s_col_model, s_col_qty, s_col_note], spacing=16),
            ft.Row([s_data_ver, s_data_date], spacing=12),
        ], spacing=10, scroll=ft.ScrollMode.AUTO, width=480, height=440),
        actions=[
            ft.TextButton("取消", on_click=lambda ev: _close_dlg(settings_dlg)),
            ft.TextButton("保存", on_click=_save_settings_dlg),
        ],
        actions_alignment=ft.MainAxisAlignment.END,
    )

    def open_settings(e):
        page.dialog = settings_dlg
        settings_dlg.open = True
        page.update()

    btn_settings = ft.ElevatedButton(
        "⚙️ 设置",
        height=34,
        bgcolor="#5A6B7B",
        color="white",
        on_click=open_settings,
    )

    # ---------- 导出记录弹窗 ----------
    btn_clear_log = ft.TextButton("清空全部", on_click=None)
    export_log_dlg = ft.AlertDialog(
        open=False,
        title=ft.Text("📋 导出记录", size=16, weight=ft.FontWeight.BOLD, color="#123A5A"),
        content=ft.Column([ft.Text("")], width=480, height=440),
        actions=[
            ft.TextButton("打开清单文件夹", on_click=open_bom_folder),
            btn_clear_log,
            ft.TextButton("关闭", on_click=lambda ev: _close_dlg(export_log_dlg)),
        ],
        actions_alignment=ft.MainAxisAlignment.END,
    )
    clear_armed = {"on": False}

    def _delete_export_entry(idx):
        entries = _read_export_log()
        removed = ""
        if 0 <= idx < len(entries):
            removed = str(entries[idx].get("文件", ""))
            entries.pop(idx)
            _write_export_log(entries)
            _log(f"删除导出记录：{removed}")
        open_export_log(None)

    def _clear_export_log(ev):
        if not clear_armed["on"]:
            clear_armed["on"] = True
            btn_clear_log.text = "再次点击确认清空"
            btn_clear_log.update()
            return
        _write_export_log([])
        clear_armed["on"] = False
        _log("清空全部导出记录")
        open_export_log(None)

    btn_clear_log.on_click = _clear_export_log

    def open_export_log(e):
        clear_armed["on"] = False
        btn_clear_log.text = "清空全部"
        entries = _read_export_log()
        rows = []
        if not entries:
            rows.append(ft.Text("暂无导出记录", size=12.5, color="#7B8794"))
        for idx, en in reversed(list(enumerate(entries))):
            sub = en.get("目录", "") or ""
            fname = en.get("文件", "")
            file_label = f"{sub}/{fname}" if sub else fname
            rows.append(ft.Column([
                ft.Row([
                    ft.Text(en.get("时间", ""), size=11, color="#7B8794"),
                    ft.Text(en.get("格式", ""), size=11, color="#3B76B5"),
                    ft.Text(f"{en.get('套数', 0)} 套", size=11, color="#7B8794"),
                    ft.IconButton(icon=ft.icons.DELETE_OUTLINE, icon_size=16, tooltip="删除该记录",
                                  on_click=lambda ev, i=idx: _delete_export_entry(i)),
                ], spacing=10, alignment=ft.MainAxisAlignment.SPACE_BETWEEN),
                ft.Text(file_label, size=12, color="#1F2733"),
                ft.Text(en.get("条件", "") or "无条件", size=11, color="#7B8794"),
            ], spacing=2))
        export_log_dlg.content = ft.Column(rows, spacing=10, scroll=ft.ScrollMode.AUTO, width=480, height=440)
        page.dialog = export_log_dlg
        export_log_dlg.open = True
        page.update()

    btn_export_log = ft.ElevatedButton(
        "📋 导出记录",
        height=34,
        bgcolor="#5A6B7B",
        color="white",
        on_click=open_export_log,
    )

    result_view = ft.Column(spacing=10)
    count_text = ft.Text("", size=13, color="grey")
    tip_text = ft.Text("", size=12, color="green")
    state = {"count": 0}
    selected = {}

    def _sel_key(it):
        return f"{it.get('motor_model')}|{it.get('drive_model')}"

    def _conditions_summary():
        parts = []
        if volt_drop.value != "全部":
            parts.append(f"电压{volt_drop.value}")
        if power_drop.value != "全部":
            parts.append(f"功率{power_drop.value}")
        if speed_drop.value != "全部":
            parts.append(f"转速{speed_drop.value}")
        if series_drop.value != "全部":
            parts.append(f"惯量{series_drop.value.split('｜')[0]}")
        if flange_drop.value != "全部":
            parts.append(f"法兰{flange_drop.value}")
        if driver_drop.value != "全部":
            parts.append(f"驱动{driver_drop.value}")
        if comm_drop.value != "全部":
            parts.append(f"通讯{comm_drop.value}")
        if enc_drop.value != "全部":
            parts.append(f"编码器{enc_drop.value}")
        if battery_drop.value != "全部":
            parts.append(f"电池{battery_drop.value}")
        if brake_check.value:
            parts.append("带抱闸")
        if oilseal_check.value:
            parts.append("带油封")
        return "；".join(parts)

    def _refresh_sel_btn():
        btn_export_sel.text = f"⬇ 导出勾选的 BOM（{len(selected)}）"
        page.update()

    def _toggle_select(it, checked):
        k = _sel_key(it)
        if checked:
            selected[k] = it
        else:
            selected.pop(k, None)
        _refresh_sel_btn()

    def on_export(e, it):
        try:
            path, n = export_bom(it, depth_drop.value, flex_check.value, cfg, base_dir,
                                 conditions_txt=_conditions_summary(),
                                 name_hint=str(it.get("motor_model") or "清单"))
            tip_text.value = f"已导出：{path}"
            tip_text.color = "green"
        except Exception as ex:
            _log(f"导出失败：{ex}", "ERROR")
            tip_text.value = f"导出失败：{ex}"
            tip_text.color = "red"
        page.update()

    def on_export_selected(e):
        items = list(selected.values())
        if not items:
            tip_text.value = "请先勾选要导出的搭配"
            tip_text.color = "#B26A00"
            page.update()
            return
        try:
            path, n = export_bom(items, depth_drop.value, flex_check.value, cfg, base_dir,
                                conditions_txt=_conditions_summary())
            tip_text.value = f"已导出 {n} 套搭配：{path}"
            tip_text.color = "green"
        except Exception as ex:
            _log(f"合并导出失败：{ex}", "ERROR")
            tip_text.value = f"导出失败：{ex}"
            tip_text.color = "red"
        page.update()

    btn_export_sel = ft.ElevatedButton(
        "⬇ 导出勾选的 BOM（0）",
        height=34,
        bgcolor="#1E7A3C",
        color="white",
        on_click=on_export_selected,
    )

    def on_clear_selection(e):
        selected.clear()
        refresh(None)
        _refresh_sel_btn()

    btn_clear_sel = ft.ElevatedButton(
        "✖ 取消勾选",
        height=34,
        bgcolor="#7B8794",
        color="white",
        on_click=on_clear_selection,
    )

    def diff_score(d):
        """给一条记录打“接近程度”分：越小越接近用户条件。返回 (分数, 差异说明)"""
        if volt_drop.value != "全部" and d.get("voltage") != volt_drop.value:
            return None
        pen, notes = 0.0, []
        if power_drop.value != "全部":
            req, act = _kw(power_drop.value), _kw(d.get("power_text"))
            if act < req - 1e-9:
                pen += 3000 + (req - act) / max(req, 1e-9) * 1000
                notes.append(f"功率{act:g}kW低于要求{req:g}kW")
            elif act > req + 1e-9:
                pen += (act - req) / max(req, 1e-9) * 300
                notes.append(f"功率 {req:g}kW→{act:g}kW（偏大可用）")
        if flange_drop.value != "全部":
            req, act = _flange_mm(flange_drop.value), _flange_mm(d.get("flange_size"))
            if abs(act - req) > 1e-9:
                pen += 400 + abs(act - req) / 20.0 * 80
                notes.append(f"法兰 {flange_drop.value}→{d.get('flange_size') or '待补'}")
        if speed_drop.value != "全部" and d.get("rated_speed") != speed_drop.value:
            pen += 200
            notes.append(f"转速 {speed_drop.value}→{d.get('rated_speed')}")
        if series_drop.value != "全部":
            pick = series_drop.value.split("｜")[0].strip()
            if d.get("series_code") != pick:
                pen += 150
                notes.append(f"惯量 {pick}→{d.get('series_code')}")
        if driver_drop.value != "全部" and not str(d.get("drive_model") or "").startswith(driver_drop.value):
            pen += 500
            notes.append(f"驱动 {driver_drop.value}→{str(d.get('drive_model') or '')}")
        if comm_drop.value != "全部" and d.get("comm") != comm_drop.value:
            pen += 400
            notes.append(f"通讯 {comm_drop.value}→{d.get('comm')}")
        if enc_drop.value != "全部" and d.get("encoder_short") != enc_drop.value:
            pen += 400
            notes.append(f"编码器 {enc_drop.value}→{d.get('encoder_short')}")
        if magnet_drop.value != "全部" and d.get("magnet_encoder") != magnet_drop.value:
            pen += 250
            notes.append("编码器形式不同")
        bat = str(d.get("battery") or "")
        if battery_drop.value == "需要" and bat != "S6-C4A":
            pen += 250
            notes.append("无电池套件")
        if battery_drop.value == "免电池" and not bat.startswith("无"):
            pen += 250
            notes.append("需配电池")
        if brake_check.value and d.get("has_brake") != "是":
            pen += 900
            notes.append("无抱闸（要求带抱闸）")
        if not brake_check.value and d.get("has_brake") == "是":
            pen += 200
            notes.append("带抱闸（要求不带）")
        if oilseal_check.value and d.get("has_oilseal") != "是":
            pen += 120
            notes.append("无油封（要求带油封）")
        if not oilseal_check.value and d.get("has_oilseal") == "是":
            pen += 120
            notes.append("带油封（要求不带）")
        return pen, notes

    def recommend(limit=5):
        """无完全匹配时，按“最接近可用”的程度给出推荐搭配"""
        scored, overflow = [], []
        for d in data:
            r = diff_score(d)
            if r is None:
                continue
            pen, notes = r
            (scored if pen < 3000 else overflow).append((pen, notes, d))
        scored.sort(key=lambda x: x[0])
        if not scored:
            scored = sorted(overflow, key=lambda x: x[0])
        picked, seen = [], set()
        for pen, notes, d in scored:
            key = str(d.get("motor_model"))
            if key in seen:
                continue
            seen.add(key)
            picked.append((pen, notes, d))
            if len(picked) >= limit:
                break
        return picked

    def _diagnose_empty():
        """逐步过滤，定位把候选筛没的瓶颈条件并给放宽建议"""
        pool = list(data)
        steps = []

        def step(label, value, pred, suggest):
            nonlocal pool
            if value == "全部":
                return
            before = len(pool)
            pool = [d for d in pool if pred(d)]
            steps.append((label, str(value), before, len(pool), suggest))

        step("供电电压", volt_drop.value, lambda d: d.get("voltage") == volt_drop.value,
             "另一档 AC220 / AC380")
        step("额定功率", power_drop.value, lambda d: _kw(d.get("power_text")) == _kw(power_drop.value), None)
        step("额定转速", speed_drop.value, lambda d: d.get("rated_speed") == speed_drop.value,
             "1500 / 2000 / 3000rpm")
        if series_drop.value != "全部":
            pick = series_drop.value.split("｜")[0].strip()
            step("惯量&容量", series_drop.value, lambda d: d.get("series_code") == pick, "放宽为「全部」")
        step("法兰尺寸", flange_drop.value, lambda d: str(d.get("flange_size") or "").strip() == flange_drop.value, None)
        if driver_drop.value != "全部":
            step("驱动器系列", driver_drop.value,
                 lambda d: str(d.get("drive_model") or "").startswith(driver_drop.value), "放宽为「全部」")
        step("通讯类型", comm_drop.value, lambda d: d.get("comm") == comm_drop.value, "放宽为「全部」")
        step("编码器", enc_drop.value, lambda d: d.get("encoder_short") == enc_drop.value, "放宽为「全部」")
        if magnet_drop.value != "全部":
            step("编码器形式", magnet_drop.value, lambda d: d.get("magnet_encoder") == magnet_drop.value, "放宽为「全部」")
        if battery_drop.value == "需要":
            step("电池", battery_drop.value, lambda d: str(d.get("battery") or "") == "S6-C4A", "放宽为「全部」")
        elif battery_drop.value == "免电池":
            step("电池", battery_drop.value, lambda d: str(d.get("battery") or "").startswith("无"), "放宽为「全部」")
        if brake_check.value:
            step("抱闸", "需要抱闸", lambda d: d.get("has_brake") == "是", "取消「需要抱闸」勾选")
        if oilseal_check.value:
            step("油封", "带油封", lambda d: d.get("has_oilseal") == "是", "取消「带油封」勾选")

        bad = [s for s in steps if s[3] == 0]
        if not bad:
            return "未找到完全匹配，可适当放宽筛选条件。"
        label, value, before, after, suggest = bad[0]
        if label == "额定功率":
            req = _kw(power_drop.value)
            lower = [p for p in power_vals if _kw(p) < req]
            upper = [p for p in power_vals if _kw(p) > req]
            cand = ([lower[-1]] if lower else []) + ([upper[0]] if upper else [])
            sug = "可试 " + " / ".join(cand) if cand else "放宽为「全部」"
        elif label == "法兰尺寸":
            sug = "库内法兰：" + " / ".join(flange_vals[:6])
        else:
            sug = suggest or "放宽为「全部」"
        return f"最可能是「{label}：{value}」把结果筛没了；建议：{sug}。"

    def card_of(it, diff=None):
        enc_short = it.get("encoder_short") or "待补"
        enc_type = it.get("encoder_type") or ""
        magnet = "免电池磁编" if it.get("magnet_encoder") == "是" else "传统光编"
        power = it.get("power_text") or "待补"
        speed = it.get("rated_speed") or "待补"
        flange = it.get("flange_size") or "待补"
        power_line = build_line(it.get("power_line_base"), depth_drop.value, flex_check.value) or "待补"
        enc_line = build_line(it.get("encoder_line_base"), depth_drop.value, flex_check.value) or "待补"

        tag = ft.Container(
            ft.Text("推荐搭配" if diff else "完全匹配", size=10.5,
                    color="#B26A00" if diff else "#1E7A3C"),
            bgcolor="#FFF3E0" if diff else "#E9F7EE",
            border_radius=9,
            padding=ft.padding.symmetric(horizontal=9, vertical=3),
        )

        def kv(k, v):
            return ft.Row([
                ft.Text(k, size=12, color="#7B8794", width=64),
                ft.Text(str(v), size=12, color="#1F2733", expand=True),
            ], spacing=4)

        left = ft.Column([
            kv("驱动器", it.get("drive_model")),
            kv("法兰", flange),
            kv("功率", power),
            kv("编码器", f"{enc_short}｜{enc_type}"),
        ], spacing=4, expand=True)
        right = ft.Column([
            kv("转速", speed),
            kv("动力线", power_line),
            kv("编码线", enc_line),
            kv("CN1", it.get("cn1")),
        ], spacing=4, expand=True)

        head_rows = [
            ft.Row([
                ft.Text(it.get("motor_model") or "待补", size=14.5,
                        weight=ft.FontWeight.BOLD, color="#123A5A", expand=True),
                tag,
            ], alignment=ft.MainAxisAlignment.SPACE_BETWEEN),
        ]
        if diff:
            head_rows.append(ft.Text(f"差异：{diff}", size=11.5, color="#B26A00", italic=True))

        return ft.Container(
            ft.Column([
                *head_rows,
                ft.Divider(height=8, color="#EDF1F6"),
                ft.Row([left, right], spacing=18),
                ft.Row([
                    ft.Checkbox(
                        value=selected.get(_sel_key(it), False),
                        on_change=lambda ev, x=it: _toggle_select(x, ev.control.value),
                    ),
                    ft.ElevatedButton(
                        "⬇ 导出这份 BOM 清单",
                        height=34,
                        bgcolor="#1E7A3C",
                        color="white",
                        on_click=lambda e, x=it: on_export(e, x),
                    ),
                    ft.ElevatedButton(
                        "✏️ 纠错",
                        height=34,
                        bgcolor="#2E6DA4",
                        color="white",
                        on_click=lambda e, x=it: _open_fix(e, x),
                    ),
                    ft.Text(cfg.get("watermark", "姓许的苏剑"), size=10.5, color="#C6CDD7"),
                ], alignment=ft.MainAxisAlignment.SPACE_BETWEEN),
            ], spacing=6),
            bgcolor="white",
            border=ft.border.all(1, "#E3E9F2"),
            border_radius=10,
            padding=14,
        )

    def refresh(e):
        res = []
        for d in data:
            if volt_drop.value != "全部" and d.get("voltage") != volt_drop.value:
                continue
            if power_drop.value != "全部" and _kw(d.get("power_text")) != _kw(power_drop.value):
                continue
            if speed_drop.value != "全部" and d.get("rated_speed") != speed_drop.value:
                continue
            if series_drop.value != "全部":
                pick = series_drop.value.split("｜")[0].strip()
                if d.get("series_code") != pick:
                    continue
            if flange_drop.value != "全部" and str(d.get("flange_size") or "").strip() != flange_drop.value:
                continue
            if driver_drop.value != "全部":
                drive_model = str(d.get("drive_model") or "").strip()
                if not drive_model.startswith(driver_drop.value):
                    continue
            if comm_drop.value != "全部" and d.get("comm") != comm_drop.value:
                continue
            if enc_drop.value != "全部" and d.get("encoder_short") != enc_drop.value:
                continue
            if magnet_drop.value != "全部" and d.get("magnet_encoder") != magnet_drop.value:
                continue
            bat = str(d.get("battery") or "")
            if battery_drop.value == "需要" and bat != "S6-C4A":
                continue
            if battery_drop.value == "免电池" and not bat.startswith("无"):
                continue
            if brake_check.value and d.get("has_brake") != "是":
                continue
            if not brake_check.value and d.get("has_brake") == "是":
                continue
            if oilseal_check.value and d.get("has_oilseal") != "是":
                continue
            if not oilseal_check.value and d.get("has_oilseal") == "是":
                continue
            res.append(d)

        state["count"] = len(res)
        result_view.controls.clear()
        if res:
            count_text.value = f"匹配 {len(res)} 条"
            count_text.color = "grey"
            for it in res:
                result_view.controls.append(card_of(it))
        else:
            diag = _diagnose_empty()
            rec = recommend()
            if not rec:
                count_text.value = "匹配 0 条"
                result_view.controls.append(ft.Text(diag, color="red"))
            else:
                count_text.value = f"完全匹配 0 条 · 已按最接近条件推荐 {len(rec)} 款"
                count_text.color = "orange"
                result_view.controls.append(ft.Text(diag, color="#B26A00"))
                result_view.controls.append(ft.Text(
                    "没有完全符合的型号，以下为最接近且可用的搭配（按接近程度排序）：", color="orange"))
                for pen, notes, it in rec:
                    result_view.controls.append(card_of(it, "；".join(notes) if notes else "无差异"))
        page.update()

    def _is_empty():
        return state["count"] == 0

    def on_driver_change(e):
        v = driver_drop.value
        if v != "全部" and v in SERIES_PRESET:
            comm, enc = SERIES_PRESET[v]
            comm_drop.value = comm
            enc_drop.value = enc
            refresh(e)
            # 预设编码器若把结果筛空，说明该系列不是这个编码器，自动回落为“全部”
            if _is_empty():
                enc_drop.value = "全部"
                refresh(e)
            # 仍为空：该系列可能只有免电池磁编机型，放开编码器形式与电池限制
            if _is_empty():
                magnet_drop.value = "全部"
                battery_drop.value = "全部"
                refresh(e)
            return
        refresh(e)

    def on_manual_change(e):
        # 手动改通讯/编码器时不再清空驱动器系列，保留用户已选的系列（如 SV660N + 传统光编）
        refresh(e)

    def on_magnet_change(e):
        # 编码器形式 ↔ 绝对值电池 联动：磁编=不配电池，光编=需电池；驱动器系列保持不变
        battery_drop.value = {"是": "免电池", "否": "需要"}.get(magnet_drop.value, "全部")
        refresh(e)

    def on_battery_change(e):
        magnet_drop.value = {"免电池": "是", "需要": "否"}.get(battery_drop.value, "全部")
        refresh(e)

    driver_drop.on_change = on_driver_change
    comm_drop.on_change = on_manual_change
    enc_drop.on_change = on_manual_change
    magnet_drop.on_change = on_magnet_change
    battery_drop.on_change = on_battery_change
    for ctrl in [volt_drop, power_drop, speed_drop, series_drop, flange_drop,
                 depth_drop, brake_check, oilseal_check, flex_check]:
        ctrl.on_change = refresh

    # ---------- 界面美化：统一控件宽度 + 卡片化布局 ----------
    for c in [volt_drop, power_drop, speed_drop, series_drop, flange_drop,
              driver_drop, comm_drop, enc_drop, magnet_drop, battery_drop, depth_drop]:
        c.width = 205

    def section_title(txt):
        return ft.Text(txt, size=13.5, weight=ft.FontWeight.BOLD, color="#123A5A")

    # ---------- LOGO：把 logo.png / logo.jpg 放在 main.py 同目录即可自动显示 ----------
    def find_logo():
        for d in (base_dir, RES_DIR):
            for ext in (".png", ".jpg", ".jpeg", ".webp", ".bmp"):
                fp = os.path.join(d, "logo" + ext)
                if os.path.exists(fp):
                    return fp
        return None

    logo_path = find_logo()
    if logo_path:
        logo_widget = ft.Image(src=logo_path, width=40, height=40, fit=ft.ImageFit.CONTAIN)
    else:
        logo_widget = ft.Container(
            ft.Text("MS", size=15, weight=ft.FontWeight.BOLD, color="white"),
            width=40, height=40, bgcolor="#2E6DA4", border_radius=9,
            alignment=ft.alignment.center,
        )

    header = ft.Container(
        ft.Row([
            ft.Container(
                logo_widget,
                bgcolor="white",
                border_radius=9,
                padding=3,
            ),
            ft.Column([
                ft.Text("汇川 MS1-R 伺服选型工具", size=21, weight=ft.FontWeight.BOLD, color="white"),
                ft.Text(f"SV600EN/EP、SV605N/P / SV630 / SV660 / SV670 / SV680　·　数据库 {len(data)} 条　·　惯量 / 法兰 / 编码器联合筛选　·　v{VERSION}",
                        size=11.5, color="#A9C4DE"),
            ], spacing=2, expand=True),
            ft.ElevatedButton(content=ft.Text("主页", weight=ft.FontWeight.BOLD, color="#123A5A"),
                               height=34, bgcolor="white", on_click=_go_home),
        ], spacing=14, alignment=ft.MainAxisAlignment.SPACE_BETWEEN),
        bgcolor="#123A5A",
        padding=ft.padding.symmetric(horizontal=20, vertical=15),
    )

    filter_card = ft.Container(
        ft.Column([
            section_title("①  选型条件"),
            ft.Row([volt_drop, power_drop, speed_drop, series_drop], spacing=12, wrap=True),
            ft.Row([flange_drop, driver_drop, comm_drop, enc_drop], spacing=12, wrap=True),
            ft.Row([magnet_drop, battery_drop, depth_drop], spacing=12, wrap=True),
            ft.Row([brake_check, oilseal_check, flex_check], spacing=22),
            ft.Row([btn_cable, btn_manual, btn_settings, btn_export_log, btn_hist, btn_open_folder], spacing=12, alignment=ft.MainAxisAlignment.END),
            ft.Divider(height=10, color="#EDF1F6"),
            ft.Text("提示：惯量 & 容量、法兰尺寸默认「全部」；没有任何型号完全符合时，会自动给出最接近的推荐搭配。",
                    size=11.5, color="#7B8794"),
        ], spacing=10),
        bgcolor="white",
        border_radius=12,
        padding=16,
        border=ft.border.all(1, "#E3E9F2"),
    )

    result_head = ft.Row([
        section_title("②  选型结果"),
        ft.Container(
            count_text,
            bgcolor="#EDF3FA",
            border_radius=10,
            padding=ft.padding.symmetric(horizontal=10, vertical=3),
        ),
        ft.Row([btn_clear_sel, btn_export_sel], spacing=10),
    ], spacing=10, alignment=ft.MainAxisAlignment.SPACE_BETWEEN)

    action_hint = ft.Text("选好型号后，点结果卡片最下方的【⬇ 导出这份 BOM 清单】即可生成 Excel 采购清单",
                          size=11.5, color="#3B76B5")

    def _footer_text():
        tag = ""
        if cfg.get("data_version") or cfg.get("data_date"):
            tag = f"　·　数据版本 {cfg.get('data_version') or '—'}（{cfg.get('data_date') or '—'}）"
        return f"{cfg.get('watermark', '姓许的苏剑')}　·　汇川 MS1-R 伺服选型工具　·　数据依据 MS1-R 系列伺服电机选型手册{tag}"

    footer_text = ft.Text(_footer_text(), size=11, color="#9AA4B2")
    footer = ft.Container(
        footer_text,
        alignment=ft.alignment.center,
        padding=ft.padding.symmetric(vertical=12),
    )

    page.bgcolor = "#F4F6FA"
    page.padding = 0

    selector_view = ft.Column([
        header,
        ft.Container(
            ft.Column([
                filter_card,
                result_head,
                action_hint,
                tip_text,
                result_view,
            ], spacing=12),
            padding=ft.padding.all(18),
        ),
        footer,
    ], spacing=0)

    # ---------- 故障码 / 警告码查询视图 ----------
    def _open_fault(e):
        _show(fault_view)

    def _fault_card(series, code, rec):
        fault_rows = rec.get("rows", [])
        meta = []
        if rec.get("level"):
            meta.append(f"级别 {rec['level']}")
        if rec.get("reset"):
            meta.append(f"可复位：{rec['reset']}")
        children = [
            ft.Row([
                ft.Text(f"{code}：{rec.get('title', '')}", size=15,
                        weight=ft.FontWeight.BOLD, color="#123A5A", expand=True),
                ft.Text("　".join(meta), size=11.5, color="#7B8794"),
            ], spacing=10),
        ]
        if rec.get("mechanism"):
            children.append(ft.Column([
                ft.Text("故障机理", size=12.5, weight=ft.FontWeight.BOLD, color="#123A5A"),
                ft.Text(rec.get("mechanism", ""), size=12.5, color="#3B4754"),
            ], spacing=4))
        if fault_rows:
            def _mcell(text, bold=False, color="#1F2733", bg=None):
                return ft.Container(
                    ft.Text(text, size=12, weight=ft.FontWeight.BOLD if bold else None, color=color),
                    padding=ft.padding.symmetric(horizontal=10, vertical=8),
                    expand=True, bgcolor=bg,
                )
            head_row = ft.Row([
                _mcell("故障原因", bold=True, color="#123A5A", bg="#F0F4F9"),
                _mcell("确认方法", bold=True, color="#123A5A", bg="#F0F4F9"),
                _mcell("处理措施", bold=True, color="#123A5A", bg="#F0F4F9"),
            ], spacing=1)
            body_rows = []
            for idx, r in enumerate(fault_rows):
                bg = "#FFFFFF" if idx % 2 == 0 else "#F7FAFD"
                body_rows.append(ft.Row([
                    _mcell(r[0], bg=bg), _mcell(r[1], bg=bg), _mcell(r[2], bg=bg),
                ], spacing=1))
            children.append(ft.Column([
                ft.Text("故障排除", size=12.5, weight=ft.FontWeight.BOLD, color="#123A5A"),
                ft.Container(
                    ft.Column([head_row] + body_rows, spacing=1),
                    border=ft.border.all(1, "#E3E9F2"), border_radius=10,
                    clip_behavior=ft.ClipBehavior.HARD_EDGE,
                ),
            ], spacing=4))
        return ft.Column(children, spacing=14)

    def _code_sort_key(code):
        head, _, sub = code.partition(".")
        nums = [int(x) for x in re.findall(r"\d+", head)]
        return (nums, sub)

    def _render_fault(series, code):
        if series not in FAULT_DB:
            return ft.Text(f"{series} 系列故障码 / 警告码库待补充。",
                           size=12.5, color="#B23A3A")
        db = FAULT_DB[series]
        q = (code or "").strip().upper().replace(" ", "").rstrip(".")
        if not q:
            return ft.Text("请输入报警码 / 故障码。", size=12.5, color="#7B8794")
        rec = db.get(q)
        if rec:
            return _fault_card(series, q, rec)
        # 未命中完整码时，按主码段（去掉子码）前缀匹配同族全部子码
        base = q.partition(".")[0]
        matched = sorted(
            [c for c in db if c.partition(".")[0] == base],
            key=_code_sort_key,
        )
        if not matched:
            return ft.Text(f"未收录 {series} 的 {code or '—'} 该码；对应手册说明待补充。",
                           size=12.5, color="#B23A3A")
        cards = [
            ft.Container(
                _fault_card(series, c, db[c]),
                bgcolor="#F7FAFD", border_radius=10, padding=12,
                border=ft.border.all(1, "#E3E9F2"),
            ) for c in matched
        ]
        return ft.Column([
            ft.Text(f"匹配到 {len(matched)} 条子码（{base}）：",
                    size=12.5, weight=ft.FontWeight.BOLD, color="#123A5A"),
            ft.Column(cards, spacing=12),
        ], spacing=14)

    fault_series = ft.Dropdown(
        label="驱动器系列",
        options=[ft.dropdown.Option(v) for v in FAULT_SERIES],
        value=FAULT_SERIES[0],
        width=180,
    )
    fault_code = ft.TextField(
        label="报警码 / 故障码",
        hint_text="如 E108.0；只输主码 E108 可列出全部子码",
        expand=True,
        on_submit=lambda e: _query_fault(None),
    )
    fault_result = ft.Container(
        ft.Text("选择驱动器系列并输入报警码 / 故障码，点击【查询】查看机理与排除方法。",
                size=12, color="#7B8794"),
        bgcolor="white", border_radius=12, padding=16,
        border=ft.border.all(1, "#E3E9F2"),
    )

    def _query_fault(e):
        series = fault_series.value
        code = (fault_code.value or "").strip().upper()
        fault_result.content = _render_fault(series, code)
        fault_result.update()

    fault_query_btn = ft.ElevatedButton("🔍 查询", height=34, bgcolor="#2E6DA4", color="white",
                                        on_click=_query_fault)

    fault_header = ft.Container(
        ft.Row([
            ft.Container(logo_widget, bgcolor="white", border_radius=9, padding=3),
            ft.Column([
                ft.Text("故障码 / 警告码查询", size=21, weight=ft.FontWeight.BOLD, color="white"),
                ft.Text("按驱动器系列查询报警码、故障码的故障机理与排除方法",
                        size=11.5, color="#A9C4DE"),
            ], spacing=2, expand=True),
            ft.ElevatedButton(content=ft.Text("主页", weight=ft.FontWeight.BOLD, color="#123A5A"),
                               height=34, bgcolor="white", on_click=_go_home),
        ], spacing=14, alignment=ft.MainAxisAlignment.SPACE_BETWEEN),
        bgcolor="#123A5A",
        padding=ft.padding.symmetric(horizontal=20, vertical=15),
    )

    fault_view = ft.Column([
        fault_header,
        ft.Container(
            ft.Column([
                ft.Row([fault_series, fault_code, fault_query_btn], spacing=12,
                       vertical_alignment=ft.CrossAxisAlignment.END),
                fault_result,
            ], spacing=12),
            padding=ft.padding.all(18),
        ),
    ], spacing=0)

    # ---------- 应用主页（启动器）：以后新增功能在此追加卡片 ----------
    def _open_selector(e):
        _show(selector_view)

    cover_container = None
    if os.path.exists(COVER_IMG):
        cover_container = ft.Container(
            ft.Image(src=COVER_IMG, height=190, fit=ft.ImageFit.COVER, expand=True),
            border_radius=14,
            clip_behavior=ft.ClipBehavior.HARD_EDGE,
        )

    select_icon_widget = (
        ft.Image(src=SELECT_ICON, width=40, height=40, fit=ft.ImageFit.CONTAIN)
        if os.path.exists(SELECT_ICON)
        else logo_widget
    )
    sel_card = ft.Container(
        ft.Row([
            ft.Container(select_icon_widget, bgcolor="white", border_radius=9, padding=3),
            ft.Column([
                ft.Text("伺服选型工具", size=18, weight=ft.FontWeight.BOLD, color="#123A5A"),
                ft.Text("电机 / 驱动器 / 动力线 / 编码线联合匹配，支持 BOM 导出、手册下载、纠错与版本恢复",
                        size=12.5, color="#5A6675"),
            ], spacing=6, expand=True),
            ft.TextButton("进入 →", on_click=_open_selector),
        ], spacing=16),
        bgcolor="white",
        border_radius=14,
        padding=18,
        border=ft.border.all(1, "#E3E9F2"),
        on_click=_open_selector,
        ink=True,
    )

    fault_icon_widget = (
        ft.Image(src=FAULT_ICON, width=40, height=40, fit=ft.ImageFit.CONTAIN)
        if os.path.exists(FAULT_ICON)
        else ft.Text("⚠️", size=22, text_align=ft.TextAlign.CENTER)
    )
    fault_card = ft.Container(
        ft.Row([
            ft.Container(fault_icon_widget, bgcolor="white", border_radius=9, padding=3),
            ft.Column([
                ft.Text("故障码 / 警告码查询", size=18, weight=ft.FontWeight.BOLD, color="#123A5A"),
                ft.Text("按驱动器系列查询报警码、故障码的故障机理与排除方法",
                        size=12.5, color="#5A6675"),
            ], spacing=6, expand=True),
            ft.TextButton("进入 →", on_click=_open_fault),
        ], spacing=16),
        bgcolor="white",
        border_radius=14,
        padding=18,
        border=ft.border.all(1, "#E3E9F2"),
        on_click=_open_fault,
        ink=True,
    )

    home_children = []
    if cover_container is not None:
        home_children.append(cover_container)
    home_children += [
        ft.Column([
            ft.Text("汇川伺服工具集", size=24, weight=ft.FontWeight.BOLD, color="#123A5A"),
            ft.Text(f"选择下方应用进入　·　v{VERSION}　·　{cfg.get('watermark', '姓许的苏剑')}",
                    size=12.5, color="#7B8794"),
        ], spacing=6),
        sel_card,
        fault_card,
        ft.Row([btn_log], alignment=ft.MainAxisAlignment.END),
    ]
    home_view = ft.Container(
        ft.Column(
            home_children,
            spacing=18,
            scroll=ft.ScrollMode.AUTO,
            horizontal_alignment=ft.CrossAxisAlignment.STRETCH,
        ),
        padding=24,
    )

    _show(home_view)
    refresh(None)

    # 主界面挂载完成后再弹出免责声明，避免“控件未加入页面即更新”报错
    page.dialog = license_dlg
    license_dlg.open = True
    page.update()

    # 替换标题栏/任务栏默认图标为本地 logo
    _apply_window_icon(page.title)


def main(page: ft.Page):
    page.title = "汇川 MS1-R 伺服选型工具"
    page.scroll = ft.ScrollMode.AUTO

    _ensure_runtime_data()
    cfg = _load_settings()
    try:
        data = load_excel(DATA_FILE)
        _log(f"数据库加载完成：{len(data)} 条")
    except Exception as ex:
        _log(f"数据库加载异常：{ex}", "ERROR")
        data = []
    _ensure_original()
    base_dir = WORK_DIR

    def apply_theme(m):
        pal = PALETTES[m]
        page.theme_mode = ft.ThemeMode.DARK if m == "dark" else ft.ThemeMode.LIGHT
        page.theme = ft.Theme(color_scheme_seed=pal["primary"])
        page.dark_theme = ft.Theme(color_scheme_seed=PALETTES["dark"]["primary"])
        page.bgcolor = pal["bg"]

    def _start_app(m):
        apply_theme(m)
        _app(page, cfg, data, base_dir, PALETTES[m], m)

    saved_mode = cfg.get("theme_mode")
    if saved_mode not in ("light", "dark"):
        saved_mode = ""

    if saved_mode:
        _start_app(saved_mode)
        return

    # ---------- 首次启动：免责声明之前先选择浅色 / 深色主题 ----------
    page.theme_mode = ft.ThemeMode.LIGHT
    page.theme = ft.Theme(color_scheme_seed=PALETTES["light"]["primary"])
    page.bgcolor = PALETTES["light"]["bg"]

    def _pick(m):
        cfg["theme_mode"] = m
        try:
            _save_settings(cfg)
            _log(f"首次选择外观主题：{m}")
        except Exception as ex:
            _log(f"主题保存失败：{ex}", "ERROR")
        pick_dlg.open = False
        page.controls.clear()
        _start_app(m)

    def _theme_card(icon, title, desc, m):
        return ft.Container(
            ft.Column([
                ft.Text(icon, size=28, text_align=ft.TextAlign.CENTER),
                ft.Text(title, size=15, weight=ft.FontWeight.BOLD, text_align=ft.TextAlign.CENTER),
                ft.Text(desc, size=11.5, color="#5A6675", text_align=ft.TextAlign.CENTER),
            ], spacing=8, horizontal_alignment=ft.CrossAxisAlignment.CENTER),
            bgcolor="white", border_radius=14, padding=18, width=180,
            border=ft.border.all(1, "#E3E9F2"), on_click=lambda e: _pick(m), ink=True,
        )

    pick_dlg = ft.AlertDialog(
        open=True,
        title=ft.Text("选择外观主题", size=16, weight=ft.FontWeight.BOLD, color="#123A5A"),
        content=ft.Column([
            ft.Text("首次使用请选择浅色或深色界面；之后可在封面「⚙️ 设置」中随时切换。",
                    size=12.5, color="#1F2733"),
            ft.Row([
                _theme_card("☀️", "浅色模式", "明亮清爽，适合白天使用", "light"),
                _theme_card("🌙", "深色模式", "深色背景，夜间更护眼", "dark"),
            ], spacing=18, alignment=ft.MainAxisAlignment.CENTER),
        ], spacing=16, tight=True, width=440),
    )
    page.dialog = pick_dlg
    page.update()


ft.app(target=main)
#（注：内容由AI生成）
