    def _snapshot_windows():
        """采集当前可见、带标题的顶层窗口句柄集合，用于打开外部程序后识别新窗口"""
        user32 = ctypes.windll.user32
        snaps = set()

        @WNDENUMPROC
        def _enum(hwnd, _):
            if user32.IsWindowVisible(hwnd):
                n = user32.GetWindowTextLengthW(hwnd)
                if n:
                    snaps.add(hwnd)
            return True

        user32.EnumWindows(_enum, 0)
        return snaps

    def _activate_window(keyword, before=None, delay=0.6):
        """打开外部文件/文件夹后，延时把对应新窗口拉到最前并激活"""
        before = before or set()

        def _worker():
            time.sleep(delay)
            try:
                user32 = ctypes.windll.user32
                kernel32 = ctypes.windll.kernel32
                matched, news = [], []

                @WNDENUMPROC
                def _enum(hwnd, _):
                    if user32.IsWindowVisible(hwnd):
                        n = user32.GetWindowTextLengthW(hwnd)
                        if n:
                            buf = ctypes.create_unicode_buffer(n + 1)
                            user32.GetWindowTextW(hwnd, buf, n + 1)
                            if keyword and keyword in buf.value:
                                matched.append(hwnd)
                            if hwnd not in before:
                                news.append(hwnd)
                    return True

                user32.EnumWindows(_enum, 0)
                target = matched[-1] if matched else (news[-1] if news else None)
                if not target:
                    return
                fg = user32.GetForegroundWindow()
                fg_tid = user32.GetWindowThreadProcessId(fg, None)
                cur_tid = kernel32.GetCurrentThreadId()
                user32.AttachThreadInput(cur_tid, fg_tid, True)
                user32.ShowWindow(target, 9)
                user32.BringWindowToTop(target)
                user32.SetActiveWindow(target)
                user32.SetForegroundWindow(target)
                user32.AttachThreadInput(cur_tid, fg_tid, False)
            except Exception:
                pass

        threading.Thread(target=_worker, daemon=True).start()

    def _close_dlg(dlg):
        dlg.open = False
        page.update()

    def open_bom_folder(e):
        folder = os.path.join(base_dir, "清单文件夹")
        os.makedirs(folder, exist_ok=True)
        os.startfile(folder)

        def _bring_front():
            time.sleep(0.5)
            try:
                user32 = ctypes.windll.user32
                kernel32 = ctypes.windll.kernel32
                target = os.path.basename(folder)
                matches = []

                @WNDENUMPROC
                def _enum(hwnd, _):
                    if user32.IsWindowVisible(hwnd):
                        n = user32.GetWindowTextLengthW(hwnd)
                        if n:
                            buf = ctypes.create_unicode_buffer(n + 1)
                            user32.GetWindowTextW(hwnd, buf, n + 1)
                            cls = ctypes.create_unicode_buffer(256)
                            user32.GetClassNameW(hwnd, cls, 256)
                            if cls.value in ("CabinetWClass", "ExploreWClass") and target in buf.value:
                                matches.append(hwnd)
                    return True

                user32.EnumWindows(_enum, 0)
                if not matches:
                    return
                hwnd = matches[-1]
                fg = user32.GetForegroundWindow()
                fg_tid = user32.GetWindowThreadProcessId(fg, None)
                cur_tid = kernel32.GetCurrentThreadId()
                user32.AttachThreadInput(cur_tid, fg_tid, True)
                user32.ShowWindow(hwnd, 9)
                user32.BringWindowToTop(hwnd)
                user32.SetActiveWindow(hwnd)
                user32.SetForegroundWindow(hwnd)
                user32.AttachThreadInput(cur_tid, fg_tid, False)
            except Exception:
                pass

        threading.Thread(target=_bring_front, daemon=True).start()

