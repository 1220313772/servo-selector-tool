    def _kw(s):
        """从 '1.3kW' 这类文本里取出数值，用于功率比较"""
        try:
            return float("".join(c for c in str(s) if c.isdigit() or c == "."))
        except Exception:
            return 0.0

    def _flange_mm(s):
        return _kw(str(s).split("×")[0])

