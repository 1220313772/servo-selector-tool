import re

# 线缆型号统一格式：S6-L-B107-3.0-T / S6-L-P124-5.0
# 前缀(族) - 长度 - 高柔标记，长度与是否高柔由界面选择决定
LINE_RE = re.compile(r"^(S6-L-[A-Z]+\d+)(?:-\d+\.\d+)?(?:-T)?$")


def build_line(code, depth, high_flex):
    """把表里的线缆型号改写成用户选择的长度/高柔版本"""
    if not code:
        return ""
    code = str(code).strip()
    m = LINE_RE.match(code)
    if not m:
        return code
    base = m.group(1)
    out = f"{base}-{depth}"
    if high_flex:
        out += "-T"
    return out


