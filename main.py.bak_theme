def _load_fault_db():
    try:
        if os.path.exists(FAULT_DB_FILE):
            with open(FAULT_DB_FILE, "r", encoding="utf-8") as f:
                data = json.load(f)
            if isinstance(data, dict):
                return data
    except Exception:
        pass
    return {}


FAULT_DB = _load_fault_db()

DEFAULT_SETTINGS = {
    "default_voltage": "AC220",
